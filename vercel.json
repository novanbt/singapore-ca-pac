{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings.js"
    },
    {
      "source": "/api/bookings/:id",
      "destination": "/api/bookings.js?id=:id"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth.js?action=login"
    },
    {
      "source": "/api/auth/update-credentials",
      "destination": "/api/auth.js?action=update"
    }
  ]
}
